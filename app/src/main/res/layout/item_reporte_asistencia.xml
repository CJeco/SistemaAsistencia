<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNombreReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Docente"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F172A"/>

        <TextView
            android:id="@+id/tvDetalleReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Fecha: 2026-06-06\n🟢 Entrada: 08:00:00  |  🔴 Salida: En curso"
            android:textSize="14sp"
            android:textColor="#475569"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>